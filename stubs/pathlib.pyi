import typing as t
from pathlib import Path as _Path # type: ignore[attr-defined]
import os
import io
import pandas as pd


OPEN_MODES = t.Literal[
    'r', 'rb',
    'w', 'wb', 
    'x', 'xb',
    'a', 'ab',
    'b',
    't',
    '+',
]

OPEN_MODES_ERROR = t.Literal[
    'strict',
    'ignore',
    'replace',
    'surrogateescape',
    'xmlcharrefreplace',
    'backslashreplace',
    'namereplace',
]

class Path(_Path): # type: ignore
    """Path Python Types"""
    
    """ System Methods"""
    drive: str
    root: str
    anchor: str
    name: str
    suffix: str
    suffixes: list[str]
    stem: str
    parts: tuple[str, ...]
    parent: "Path"
    parents: list["Path"]
    
    
    @classmethod
    def cwd(cls) -> "Path": ...
    
    @classmethod
    def home(cls) -> "Path": ...
    
    def samefile(self, other_path: os.PathLike) -> bool: ...
    
    def as_posix(self) -> "Path": ...
    
    def as_uri(self) -> str: ...
    
    def with_name(self, name: str) -> "Path": ...
    
    def with_stem(self, stem: str) -> "Path": ...
    
    def with_suffix(self, suffix: str) -> "Path": ...
    
    def relative_to(self, *other) -> "Path": ...
    
    def is_relative_to(self, *other) -> bool: ...
    
    def joinpath(self, *args) -> "Path": ...
    
    def is_absolute(self) -> bool: ...
    
    def is_reserved(self) -> bool: ...
    
    def match(self, path_pattern: str) -> bool: ...
    
    def iterdir(self) -> t.Iterator["Path"]: ...
    
    def glob(self, pattern: str) -> t.Iterator["Path"]: ...
    
    def rglob(self, pattern: str) -> t.Iterator["Path"]: ...
    
    def absolute(self) -> "Path": ...
    
    def resolve(self, strict: bool = False) -> "Path": ...
    
    def owner(self) -> str: ...
    
    def group(self) -> str: ...
    
    def open(self, mode: OPEN_MODES  = 'r', buffering: int = -1, encoding: str | None = None,
             errors: OPEN_MODES_ERROR | None = None, newline: str | None = None) -> io.TextIOWrapper: ...
    
    def read_bytes(self) -> bytes: ...
    
    def read_text(self, encoding: str | None = None, errors: OPEN_MODES_ERROR | None = None) -> str: ...
    
    def write_bytes(self, data: bytes) -> None: ...
    
    def write_text(self, data: str, encoding: str | None = None, errors: OPEN_MODES_ERROR | None = None,
                   newline: str | None = None) -> None: ...
    
    def readlink(self) -> "Path": ...
    
    def touch(self, mode: int = 0o666, exist_ok: bool = True) -> None:...
    
    def mkdir(self, mode: int = 0o777, parents: bool = False, exist_ok: bool = False): ...
    
    def chmod(self, mode: int, *, follow_symlinks: bool = True) -> None: ...
    
    def lchmod(self, mode: int) -> None: ...
    
    def unlink(self, missing_ok: bool = False): ...
    
    def rmdir(self) -> None: ...
    
    def stat(self, *, follow_symlinks: bool = True) -> os.stat_result: ...
    
    def lstat(self) -> os.stat_result: ...
    
    def rename(self, target: "Path") -> "Path": ...
    
    def replace(self, target: "Path") -> "Path": ...
    
    def symlink_to(self, target: "Path", target_is_directory: bool = False) -> None: ...
    
    def hardlink_to(self, target: "Path") -> None: ...
    
    def link_to(self, target: "Path") -> None: ...
    
    def exists(self) -> bool: ...
    
    def is_dir(self) -> bool: ...
    
    def is_file(self) -> bool: ...
    
    def is_mount(self) -> bool: ...
    
    def is_symlink(self) -> bool: ...
    
    def is_block_device(self) -> bool: ...
    
    def is_char_device(self) -> bool: ...
    
    def is_fifo(self) -> bool: ...
    
    def is_socket(self) -> bool: ...
    
    def expanduser(self) -> "Path": ...
    
    """ Custom Methods """
    def mk_parent(self: "Path") -> None: ...
    
    def safe_readlines(self: "Path") -> list[str]: ...

    def read_tokenized(self: "Path") -> list[str]: ...

    def safe_write_text(self: "Path", text: str) -> None: ...
    
    def safe_append_text(self: "Path", text: str) -> None: ...
    
    def dump_json(self: "Path", data: t.Any) -> None: ...

    def load_json(self: "Path") -> t.Any: ...

    def extend(self: "Path", parts: tuple[str, ...]) -> "Path": ...
    
    def dump_toml(self: "Path", data: t.Any) -> None: ...

    def load_toml(self: "Path") -> t.Any: ...
    
    def dump_yaml(self: "Path", data: t.Any) -> None: ...

    def load_yaml(self: "Path") -> t.Any: ...

    def read_csv(self: "Path", columns: list[str] | None = None, sep: str | None = None, **kwargs) -> pd.DataFrame: ...
